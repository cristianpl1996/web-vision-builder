# Copiar a .env (no se sube a git) y cambiar los secretos.
POSTGRES_PASSWORD=sinergia
# Firma las sesiones (JWT) y cifra las credenciales guardadas en Admin › Ajustes.
# En producción: un texto largo y aleatorio. Si se cambia, se cierran todas las sesiones
# y hay que volver a cargar las credenciales de Mercado Pago y SMTP.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-produccion
# Dónde vive la web (enlaces de los correos y regreso desde Mercado Pago).
APP_URL=http://localhost:8090
# URL pública https para el webhook de Mercado Pago. Vacía en local: el pago se confirma
# igual al volver a la tienda (se consulta la API de MP).
WEBHOOK_URL_PUBLICA=
# JSON: orígenes del navegador que pueden llamar a la API.
CORS_ORIGENES=["http://localhost:8080","http://localhost:8081","http://localhost:8090","http://localhost:5174"]

# SMTP de respaldo (lo de Admin › Ajustes manda sobre esto). En desarrollo, Mailpit:
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_REMITENTE=SINERGIA <no-responder@sinergia.local>

# Datos de prueba (desarrollo): usuarios de cada rol, catálogo con fotos y precios, y ajustes de ejemplo.
#   docker compose exec backend python -m app.sembrar
#   → superadmin@sinergia.local · admin@sinergia.local · cliente@sinergia.local (contraseña Sinergia2026)
# En producción: python -m app.sembrar --password "<una propia>"  o  python -m app.crear_superadmin <correo> <contraseña>
